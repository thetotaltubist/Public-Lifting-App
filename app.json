{
  "expo": {
    "name": "Every Set Counts",
    "slug": "every-set-counts",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "everysetcounts",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-light.png",
    "runtimeVersion": {
      "policy": "nativeVersion"
    },
    "ios": {
      "bundleIdentifier": "com.jdicesar.everysetcounts",
      "supportsTablet": true,
      "appleTeamId": "7V9S64W92Z",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Reads your weight and sleep from Apple Health to keep a cut from costing muscle and to skip extra sets after short nights. Nothing is written to Health.",
        "NSHealthUpdateUsageDescription": "This app never writes to Apple Health. Apple requires this text because the app uses HealthKit."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3EFE6",
          "dark": {
            "image": "./assets/icon-dark.png",
            "backgroundColor": "#26372E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
